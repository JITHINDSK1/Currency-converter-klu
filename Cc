import java.util.*;
import java.text.DecimalFormat;

public class WorldCurrencyConverter {

    // Global Maps to store Rates and Names
    // CO-6: Using Collections Framework (HashMap)
    private static final Map<String, Double> ratesToUSD = new TreeMap<>(); // TreeMap keeps it sorted alphabetically
    private static final Map<String, String> currencyNames = new HashMap<>();

    // co-1: Initialize Data (The Database of Currencies)
    // Rates are approximate (1 USD = X Units) as of Late 2024/2025 context
    public static void initializeCurrencies() {
