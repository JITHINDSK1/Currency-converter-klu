    }

    // Helper to add to maps
    private static void addCurrency(String code, double rate, String name) {
        ratesToUSD.put(code, rate);
        currencyNames.put(code, name);
    }

    // co-2: Display all available codes
    public static void displayAllCurrencies() {
        System.out.println("\n===== AVAILABLE CURRENCIES (" + ratesToUSD.size() + " Total) =====");
        int count = 0;
        for (String code : ratesToUSD.keySet()) {
            System.out.printf("%-4s : %-25s  ", code, currencyNames.get(code));
            count++;
            if (count % 2 == 0) System.out.println(); // New line every 2 items
        }
        System.out.println("\n=======================================================");
    }

    // co-3: Get Valid Currency Code from User
    public static String getCurrencyCode(Scanner sc, String prompt) {
        while (true) {
            System.out.print(prompt);
            String input = sc.next().toUpperCase().trim();
            
            if (input.equals("LIST")) {
                displayAllCurrencies();
                continue;
            }

            if (ratesToUSD.containsKey(input)) {
                return input;
            } else {
                System.out.println("Invalid Code. Type 'LIST' to see all options or try again.");
            }
        }
    }

    // co-4: Get Valid Amount
    public static double getAmount(Scanner sc) {
        while (true) {
            System.out.print("Enter Amount: ");
            if (sc.hasNextDouble()) {
                double amount = sc.nextDouble();
                if (amount >= 0) return amount;
            } else {
                sc.next(); // clear error
            }
            System.out.println("Error: Please enter a valid positive number.");
        }
    }

    // co-5: Core Calculation Logic
    // Logic: Convert FROM -> USD, then USD -> TO
    public static double convert(double amount, String fromCode, String toCode) {
        double fromRate = ratesToUSD.get(fromCode); // e.g., 84.65 (INR)
        double toRate = ratesToUSD.get(toCode);     // e.g., 0.95 (EUR)

        // Step 1: Convert 'From' currency to USD
        // If 1 USD = 84.65 INR, then 1 INR = 1/84.65 USD
        double amountInUSD = amount / fromRate;

        // Step 2: Convert USD to 'To' currency
        // If 1 USD = 0.95 EUR, then AmountUSD * 0.95 = EUR
        double convertedAmount = amountInUSD * toRate;

        return convertedAmount;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        DecimalFormat df = new DecimalFormat("#,##0.00");

        // Load all data
        initializeCurrencies();

        System.out.println("=================================================");
        System.out.println("      WORLD CURRENCY CONVERTER (GLOBAL)          ");
        System.out.println("=================================================");
        System.out.println("Instructions: Enter the 3-letter code (e.g., USD, INR).");
        System.out.println("Type 'LIST' at any code prompt to see all " + ratesToUSD.size() + " currencies.");

        while (true) {
            System.out.println("\n-------------------------------------------------");
            
            // Get Inputs
            String fromCode = getCurrencyCode(sc, "Convert FROM (Code): ");
            String toCode = getCurrencyCode(sc, "Convert TO   (Code): ");
            double amount = getAmount(sc);

            // Perform Conversion
            double result = convert(amount, fromCode, toCode);

            // Display Result
            System.out.println("\n>>> RESULT:");
            System.out.printf("%s %s (%s) \n    = %s %s (%s)%n", 
                df.format(amount), fromCode, currencyNames.get(fromCode),
                df.format(result), toCode, currencyNames.get(toCode)
            );

            // Check loop
            System.out.print("\nConvert another? (y/n): ");
            String choice = sc.next();
            if (!choice.equalsIgnoreCase("y")) {
                System.out.println("Thank you for using Currency Converter");
                break;
            }
        }
        sc.close();
    }
}
