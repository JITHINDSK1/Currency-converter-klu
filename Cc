        addCurrency("MXN", 20.50, "Mexican Peso");

        // Europe
        addCurrency("EUR", 0.95, "Euro");
        addCurrency("GBP", 0.79, "British Pound Sterling");
        addCurrency("CHF", 0.89, "Swiss Franc");
        addCurrency("SEK", 10.95, "Swedish Krona");
        addCurrency("NOK", 11.20, "Norwegian Krone");
        addCurrency("DKK", 7.10, "Danish Krone");
        addCurrency("RUB", 100.50, "Russian Ruble");
        addCurrency("PLN", 4.15, "Polish Zloty");
        addCurrency("TRY", 36.50, "Turkish Lira");
        addCurrency("HUF", 380.00, "Hungarian Forint");
        addCurrency("CZK", 23.80, "Czech Koruna");

        // Asia
        addCurrency("INR", 84.65, "Indian Rupee");
        addCurrency("JPY", 154.20, "Japanese Yen");
        addCurrency("CNY", 7.28, "Chinese Yuan");
        addCurrency("HKD", 7.78, "Hong Kong Dollar");
        addCurrency("SGD", 1.34, "Singapore Dollar");
        addCurrency("KRW", 1405.00, "South Korean Won");
        addCurrency("IDR", 16250.00, "Indonesian Rupiah");
        addCurrency("MYR", 4.45, "Malaysian Ringgit");
        addCurrency("THB", 34.50, "Thai Baht");
        addCurrency("VND", 25400.00, "Vietnamese Dong");
        addCurrency("PHP", 58.80, "Philippine Peso");
        addCurrency("PKR", 278.50, "Pakistani Rupee");
        addCurrency("BDT", 120.00, "Bangladeshi Taka");
        addCurrency("LKR", 300.00, "Sri Lankan Rupee");
        addCurrency("NPR", 135.50, "Nepalese Rupee");
        addCurrency("AED", 3.67, "UAE Dirham");
        addCurrency("SAR", 3.75, "Saudi Riyal");
        addCurrency("ILS", 3.70, "Israeli Shekel");
        addCurrency("KWD", 0.31, "Kuwaiti Dinar"); // Strong currency

        // Oceania
        addCurrency("AUD", 1.56, "Australian Dollar");
        addCurrency("NZD", 1.70, "New Zealand Dollar");

        // South America
        addCurrency("BRL", 5.85, "Brazilian Real");
        addCurrency("ARS", 1050.00, "Argentine Peso");
        addCurrency("CLP", 980.00, "Chilean Peso");
        addCurrency("COP", 4100.00, "Colombian Peso");
